{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Volumes/DATA/GitHub/specflow/.codex/hooks/block-generated-paths.py'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Volumes/DATA/GitHub/specflow/.codex/hooks/post-edit-lint.py'"
          },
          {
            "type": "command",
            "command": "python3 '/Volumes/DATA/GitHub/specflow/.codex/hooks/post-edit-test.py'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Volumes/DATA/GitHub/specflow/.codex/hooks/post-edit-lint.py'"
          },
          {
            "type": "command",
            "command": "python3 '/Volumes/DATA/GitHub/specflow/.codex/hooks/post-edit-test.py'"
          }
        ]
      }
    ]
  }
}
